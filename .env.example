# APK/web: public Vercel endpoint that returns ONLY ad configuration.
VITE_AD_CONFIG_URL=https://TU-PROYECTO.vercel.app/api/ads

# Vercel environment variables for /api/ads
ADMOB_ENABLED=false
ADMOB_BANNER_AD_UNIT_ID=
ADMOB_IS_TESTING=true
ADMOB_NPA=false

# Android build only. AdMob App ID is a public identifier, not a secret.
ADMOB_APP_ID=
ADMOB_TAG_FOR_UNDER_AGE=false
